---
interface Props {
  items: { q: string; a: string }[];
}
const { items } = Astro.props;
---

<div class="faq">
  {
    items.map((item) => (
      <details class="card">
        <summary>{item.q}</summary>
        <p class="muted" set:html={item.a} />
      </details>
    ))
  }
</div>

<style>
  .faq {
    display: grid;
    gap: 0.75rem;
    max-width: 820px;
  }
  details {
    padding: 0;
  }
  summary {
    cursor: pointer;
    padding: 1.1rem 1.5rem;
    font-weight: 600;
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary::after {
    content: "+";
    font-family: var(--mono);
    color: var(--accent);
    font-size: 1.2rem;
    transition: transform 0.2s ease;
  }
  details[open] summary::after {
    transform: rotate(45deg);
  }
  details p {
    padding: 0 1.5rem 1.2rem;
    margin: 0;
  }
</style>
