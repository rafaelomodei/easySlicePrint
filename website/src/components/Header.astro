---
import { site } from "../data/site";
import { navSections, useTranslations, localeUrl, type Lang } from "../i18n";
import LangSwitch from "./LangSwitch.astro";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<header class="header">
  <div class="container">
    <div class="bar">
      <a class="brand" href={localeUrl(lang)} aria-label={t.header.home}>
        <img src={`${base}/favicon.svg`} width="30" height="30" alt="" />
        <span>{site.name}</span>
      </a>
      <nav class="nav" aria-label={t.header.sections}>
        {navSections.map((item) => <a href={item.href}>{t.nav[item.key]}</a>)}
      </nav>
      <div class="actions">
        <LangSwitch lang={lang} />
        <a class="gh" href={site.repoUrl} target="_blank" rel="noopener" aria-label="GitHub">
          <svg width="18" height="18" viewBox="0 0 16 16" aria-hidden="true" fill="currentColor">
            <path
              d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8z"
            ></path>
          </svg>
        </a>
        <a class="btn btn-primary btn-sm" href="#download">{t.header.download}</a>
      </div>
    </div>
  </div>
</header>

<style>
  /* A floating stadium bar, detached from the viewport edge. */
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    padding-top: 0.75rem;
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    height: 60px;
    padding: 0 0.75rem 0 0.9rem;
    border-radius: var(--r-full);
    background: rgba(243, 243, 243, 0.88);
    backdrop-filter: saturate(180%) blur(16px);
    -webkit-backdrop-filter: saturate(180%) blur(16px);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-weight: var(--w-head);
    color: var(--ink);
    text-decoration: none;
    white-space: nowrap;
  }
  .brand img {
    border-radius: 30%;
  }
  .nav {
    display: flex;
    gap: 1.5rem;
    margin-left: auto;
  }
  .nav a {
    color: var(--ink);
    font-size: 0.9375rem;
    text-decoration: none;
    opacity: 0.75;
    transition: opacity 0.15s ease;
  }
  .nav a:hover {
    opacity: 1;
  }
  .actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .gh {
    display: inline-grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    color: var(--ink);
    transition: background 0.15s ease;
  }
  .gh:hover {
    background: var(--canvas);
  }
  @media (max-width: 1040px) {
    .nav {
      display: none;
    }
    .actions {
      margin-left: auto;
    }
  }
  @media (max-width: 560px) {
    /* the logo carries the brand; the wordmark makes room for the language picker */
    .brand span {
      display: none;
    }
    .bar {
      gap: 0.5rem;
      padding-left: 0.6rem;
    }
  }
  @media (max-width: 380px) {
    .gh {
      display: none;
    }
  }
</style>
