---
/**
 * Language picker. Plain links, so it works without JavaScript; the inline
 * script only records the choice in `localStorage` so the auto-detect redirect
 * on the default-locale page never overrides a manual pick.
 */
import { languages, localeUrl, useTranslations, type Lang } from "../i18n";

interface Props {
  lang: Lang;
  class?: string;
}

const { lang, class: className = "" } = Astro.props;
const t = useTranslations(lang);
---

<nav class:list={["langs", className]} aria-label={t.language.label}>
  {
    languages.map((code) => (
      <a
        class:list={["lang", { active: code === lang }]}
        href={localeUrl(code)}
        data-lang={code}
        hreflang={code}
        lang={code}
        title={t.language.names[code]}
        aria-current={code === lang ? "true" : undefined}
      >
        <span aria-hidden="true">{code.toUpperCase()}</span>
        <span class="sr-only">{t.language.names[code]}</span>
      </a>
    ))
  }
</nav>

<script is:inline>
  // Remember the language the visitor picked, so the auto-detect redirect on
  // the English page stops kicking in.
  document.addEventListener("click", function (event) {
    var target = event.target;
    var link = target && target.closest ? target.closest("[data-lang]") : null;
    if (!link) return;
    try {
      localStorage.setItem("esp-lang", link.getAttribute("data-lang"));
    } catch (error) {
      /* private mode / storage disabled — the link still navigates */
    }
  });
</script>

<style>
  /* Segmented control: a hairline track holding pill options, the active one a white pill. */
  .langs {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    padding: 3px;
    border-radius: var(--r-full);
    box-shadow: inset 0 0 0 1px var(--hairline);
  }
  .lang {
    display: inline-grid;
    place-items: center;
    height: 28px;
    min-width: 34px;
    padding: 0 0.5rem;
    border-radius: var(--r-full);
    font-size: 0.75rem;
    font-weight: var(--w-strong);
    color: var(--text-muted);
    text-decoration: none;
    line-height: 1;
  }
  .lang:hover {
    color: var(--ink);
  }
  .lang.active {
    color: var(--ink);
    background: var(--canvas);
    box-shadow: 0 1px 2px rgba(20, 20, 20, 0.08);
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
