---
/**
 * Renders one entry of `src/data/media.ts`: an image, a self-hosted video, a
 * YouTube embed, or — while `placeholder` is set — the placeholder illustration
 * with a "coming soon" overlay and the shot description.
 */
import type { MediaSlot } from "../data/media";
import { useTranslations, type Lang } from "../i18n";

interface Props {
  slot: MediaSlot;
  lang: Lang;
  class?: string;
  /** Larger overlay for the hero. */
  large?: boolean;
}

const { slot, lang, class: className = "", large = false } = Astro.props;
const t = useTranslations(lang);
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const resolve = (p: string) => (/^https?:\/\//.test(p) ? p : `${base}/${p.replace(/^\//, "")}`);
const aspect = slot.aspect ?? "16 / 9";
const isVideoPlaceholder = slot.placeholder && slot.kind !== "image";
---

<figure class:list={["media", className, { placeholder: slot.placeholder, large }]} style={`aspect-ratio:${aspect}`}>
  {
    slot.placeholder ? (
      <>
        <img src={resolve(slot.src)} alt={slot.alt} loading="lazy" decoding="async" />
        <div class="overlay" aria-hidden="true">
          {isVideoPlaceholder && (
            <span class="play">
              <svg viewBox="0 0 24 24" width="28" height="28" fill="currentColor">
                <path d="M8 5v14l11-7z" />
              </svg>
            </span>
          )}
          <span class="badge">{isVideoPlaceholder ? t.media.badgeVideo : t.media.badgeImage}</span>
          {slot.expects && <span class="expects">{slot.expects}</span>}
        </div>
      </>
    ) : slot.kind === "youtube" ? (
      <iframe
        src={`https://www.youtube-nocookie.com/embed/${slot.src}?rel=0`}
        title={slot.alt}
        loading="lazy"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
        allowfullscreen
      />
    ) : slot.kind === "video" ? (
      <video
        src={resolve(slot.src)}
        poster={slot.poster ? resolve(slot.poster) : undefined}
        controls
        muted
        loop
        playsinline
        preload="metadata"
        aria-label={slot.alt}
      />
    ) : (
      <img src={resolve(slot.src)} alt={slot.alt} loading="lazy" decoding="async" />
    )
  }
  {slot.caption && <figcaption>{slot.caption}</figcaption>}
</figure>

<style>
  /* Footage is the only colour on the page: flat tiles, no shadow, 24px corners. */
  .media {
    position: relative;
    margin: 0;
    width: 100%;
    border-radius: var(--r-md);
    overflow: hidden;
    background: var(--canvas-soft);
  }
  .media > img,
  .media > video,
  .media > iframe {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border: 0;
  }
  figcaption {
    position: absolute;
    left: 50%;
    bottom: 0.9rem;
    transform: translateX(-50%);
    padding: 0.35rem 0.8rem;
    border-radius: var(--r-full);
    font-size: 0.75rem;
    font-weight: var(--w-strong);
    color: var(--on-ink);
    background: var(--overlay);
    backdrop-filter: blur(8px);
    white-space: nowrap;
  }
  .overlay {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    padding: 1rem;
    text-align: center;
  }
  .play {
    width: 60px;
    height: 60px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--canvas);
    color: var(--ink);
  }
  .play svg {
    margin-left: 3px;
  }
  .large .play {
    width: 80px;
    height: 80px;
  }
  .badge,
  .expects {
    border-radius: var(--r-full);
    background: var(--overlay);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    color: var(--on-ink);
  }
  .badge {
    padding: 0.35rem 0.8rem;
    font-size: 0.75rem;
    font-weight: var(--w-strong);
  }
  .expects {
    max-width: 38ch;
    padding: 0.35rem 0.9rem;
    font-size: 0.78rem;
    line-height: 1.4;
    border-radius: var(--r-sm);
  }
  .large .expects {
    font-size: 0.85rem;
    max-width: 48ch;
  }
</style>
