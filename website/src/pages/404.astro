---
/**
 * GitHub Pages serves a single 404 document for the whole site, so this page
 * stays in the default locale; the header language picker is still there.
 */
import Base from "../layouts/Base.astro";
import { defaultLang, localeUrl, useTranslations } from "../i18n";

const lang = defaultLang;
const t = useTranslations(lang);
---

<Base lang={lang} title={t.notFound.title}>
  <section class="section">
    <div class="container nf">
      <span class="code">{t.notFound.code}</span>
      <h1>{t.notFound.heading}</h1>
      <p class="muted">{t.notFound.body}</p>
      <a class="btn btn-primary" href={localeUrl(lang)}>{t.notFound.cta}</a>
    </div>
  </section>
</Base>

<style>
  .nf {
    text-align: center;
    padding-block: 4rem 0;
  }
  .code {
    display: block;
    font-size: clamp(5rem, 16vw, 9rem);
    font-weight: var(--w-head);
    line-height: 1;
    color: var(--text-faint);
    margin-bottom: 1rem;
  }
  h1 {
    font-size: clamp(2rem, 5vw, 3.5rem);
  }
  p {
    font-size: 1.25rem;
    font-weight: 300;
    margin-bottom: 2rem;
  }
</style>
