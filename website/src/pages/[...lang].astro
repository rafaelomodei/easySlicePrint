---
/**
 * The landing page, rendered once per language.
 *
 *   /      → en (default locale, no prefix)
 *   /pt/   → Português
 *   /es/   → Español
 *
 * All copy lives in `src/i18n/{en,pt,es}.ts`.
 */
import Base from "../layouts/Base.astro";
import Media from "../components/Media.astro";
import Section from "../components/Section.astro";
import Feature from "../components/Feature.astro";
import Faq from "../components/Faq.astro";
import { site } from "../data/site";
import { defaultLang, languages, localizedMedia, useTranslations, type Lang } from "../i18n";

export function getStaticPaths() {
  return languages.map((lang) => ({
    params: { lang: lang === defaultLang ? undefined : lang },
    props: { lang },
  }));
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const m = localizedMedia(t);

/** Icons are language-independent; the titles/bodies come from `t.features.items`. */
const featureIcons: Record<keyof typeof t.features.items, string> = {
  plane: "\u{1F4D0}",
  curve: "\u3030\uFE0F",
  freehand: "\u{1F504}",
  baseSplit: "\u{1F9B6}",
  quickCut: "\u26A1",
  planMode: "\u{1F5C2}\uFE0F",
  connectors: "\u{1F529}",
  kerf: "\u{1F4CF}",
  remesh: "\u{1F9CA}",
  exploded: "\u{1F4A5}",
  export: "\u{1F4E6}",
  checkMesh: "\u2705",
};
const features = Object.entries(t.features.items) as [keyof typeof featureIcons, { title: string; body: string }][];
---

<Base lang={lang} autoDetect={lang === defaultLang}>
  <!-- ============ HERO ============ -->
  <section class="hero">
    <div class="container">
      <div class="hero-copy">
        <div class="pills">
          <span class="pill accent">{t.status.pill}</span>
          <span class="pill" set:html={t.hero.pillFree} />
          <span class="pill outline">{t.hero.pillBlender}</span>
          <span class="pill outline">{t.hero.pillPlatforms}</span>
        </div>
        <h1>{t.hero.titleLead} <span class="soft-word">{t.hero.titleAccent}</span></h1>
        <p class="lead">{t.hero.lead}</p>
        <div class="cta">
          <a class="btn btn-primary" href="#download">
            {t.hero.download} <small>{t.hero.free}</small>
          </a>
          <a class="btn btn-outline" href={site.repoUrl} target="_blank" rel="noopener">{t.hero.github}</a>
        </div>
        <p class="faint fine">{t.hero.fine}</p>
      </div>
      <div class="hero-media">
        <Media slot={m.hero} lang={lang} large />
      </div>
      <p class="notice hero-notice" set:html={t.status.note} />
    </div>
  </section>

  <!-- ============ WORKFLOW ============ -->
  <Section id="workflow" eyebrow={t.workflow.eyebrow} title={t.workflow.title} intro={t.workflow.intro}>
    <div class="grid grid-3 steps-grid">
      <div class="step">
        <Media slot={m.stepCut} lang={lang} />
        <h3><span class="num">1</span> {t.workflow.steps.cut.title}</h3>
        <p class="muted">{t.workflow.steps.cut.body}</p>
      </div>
      <div class="step">
        <Media slot={m.stepConnectors} lang={lang} />
        <h3><span class="num">2</span> {t.workflow.steps.connectors.title}</h3>
        <p class="muted">{t.workflow.steps.connectors.body}</p>
      </div>
      <div class="step">
        <Media slot={m.stepExport} lang={lang} />
        <h3><span class="num">3</span> {t.workflow.steps.export.title}</h3>
        <p class="muted">{t.workflow.steps.export.body}</p>
      </div>
    </div>
  </Section>

  <!-- ============ PLAN MODE ============ -->
  <Section id="plan-mode" eyebrow={t.planMode.eyebrow} title={t.planMode.title} intro={t.planMode.intro}>
    <div class="stack">
      <div class="split">
        <div>
          <h3>{t.planMode.plane.title}</h3>
          <p class="muted" set:html={t.planMode.plane.body} />
          <ul class="checks">
            {t.planMode.plane.checks.map((item) => <li set:html={item} />)}
          </ul>
        </div>
        <Media slot={m.planeCut} lang={lang} />
      </div>

      <div class="split reverse">
        <div>
          <h3>{t.planMode.curve.title}</h3>
          <p class="muted" set:html={t.planMode.curve.body} />
          <ul class="checks">
            {t.planMode.curve.checks.map((item) => <li set:html={item} />)}
          </ul>
        </div>
        <Media slot={m.curveCut} lang={lang} />
      </div>

      <div class="split">
        <div>
          <h3>{t.planMode.freehand.title}</h3>
          <p class="muted" set:html={t.planMode.freehand.body} />
          <ul class="checks">
            {t.planMode.freehand.checks.map((item) => <li set:html={item} />)}
          </ul>
        </div>
        <Media slot={m.freehandCut} lang={lang} />
      </div>

      <div class="split reverse">
        <div>
          <h3>{t.planMode.build.title}</h3>
          <p class="muted" set:html={t.planMode.build.body} />
          <ul class="checks">
            {t.planMode.build.checks.map((item) => <li set:html={item} />)}
          </ul>
        </div>
        <Media slot={m.buildExport} lang={lang} />
      </div>
    </div>
  </Section>

  <!-- ============ QUICK CUT ============ -->
  <Section id="quick-cut" eyebrow={t.quickCut.eyebrow} title={t.quickCut.title} intro={t.quickCut.intro}>
    <div class="split">
      <Media slot={m.quickCut} lang={lang} />
      <div>
        <ul class="checks">
          {t.quickCut.checks.map((item) => <li set:html={item} />)}
        </ul>
      </div>
    </div>
  </Section>

  <!-- ============ CONNECTORS ============ -->
  <Section id="connectors" eyebrow={t.connectors.eyebrow} title={t.connectors.title} intro={t.connectors.intro}>
    <div class="split">
      <div>
        <div class="shapes">
          {t.connectors.shapes.map((shape) => <span class="pill">{shape}</span>)}
          <span class="pill outline">{t.connectors.shapesCustom}</span>
        </div>
        <ul class="checks">
          {t.connectors.checks.map((item) => <li set:html={item} />)}
        </ul>
      </div>
      <Media slot={m.connectors} lang={lang} />
    </div>
  </Section>

  <!-- ============ FEATURES ============ -->
  <Section id="features" eyebrow={t.features.eyebrow} title={t.features.title}>
    <div class="grid grid-3">
      {features.map(([key, item]) => <Feature icon={featureIcons[key]} title={item.title}>{item.body}</Feature>)}
    </div>
  </Section>

  <!-- ============ WHO ============ -->
  <Section id="who" eyebrow={t.who.eyebrow} title={t.who.title}>
    <div class="grid grid-3">
      {
        Object.values(t.who.cards).map((card) => (
          <div class="card soft">
            <h3 set:html={card.title} />
            <p class="muted">{card.body}</p>
          </div>
        ))
      }
    </div>
  </Section>

  <!-- ============ COMPAT ============ -->
  <Section id="compat" eyebrow={t.compat.eyebrow} title={t.compat.title}>
    <div class="grid grid-2">
      <div class="card">
        <h3>{t.compat.compatibility.title}</h3>
        <ul class="checks">
          {t.compat.compatibility.checks.map((item) => <li set:html={item} />)}
        </ul>
      </div>
      <div class="card">
        <h3>{t.compat.performance.title}</h3>
        <ul class="checks">
          {t.compat.performance.checks.map((item) => <li set:html={item} />)}
        </ul>
      </div>
      <div class="card soft limits">
        <h3>{t.compat.limits.title}</h3>
        <ul class="plain muted">
          {t.compat.limits.items.map((item) => <li set:html={item} />)}
        </ul>
      </div>
    </div>
  </Section>

  <!-- ============ INSTALL ============ -->
  <Section id="install" eyebrow={t.install.eyebrow} title={t.install.title}>
    <div class="split">
      <ol class="steps">
        {t.install.steps.map((step) => <li set:html={step} />)}
      </ol>
      <div class="card soft quickstart">
        <h3>{t.install.quickstart.title}</h3>
        <ol class="plain muted">
          {t.install.quickstart.steps.map((step) => <li set:html={step} />)}
        </ol>
        <p class="faint fine">{t.install.quickstart.note}</p>
      </div>
    </div>
  </Section>

  <!-- ============ DOWNLOAD ============ -->
  <section id="download" class="section download">
    <div class="container">
      <div class="download-box">
        <div class="download-copy">
          <span class="eyebrow">{t.download.eyebrow}</span>
          <h2>{site.name} <span class="ver">v{site.version}</span> <span class="pill accent">{t.status.pill}</span></h2>
          <p class="muted">{t.download.body}</p>
          <div class="cta">
            <a class="btn btn-primary" href={site.links.downloadZip}>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 3v12m0 0 4-4m-4 4-4-4M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2" />
              </svg>
              easy_slice_print-{site.version}.zip
            </a>
            <a class="btn btn-outline" href={site.links.blenderExtension} target="_blank" rel="noopener">{t.download.extension}</a>
          </div>
          <div class="links">
            <a class="btn btn-soft btn-sm" href={site.links.releases} target="_blank" rel="noopener">{t.download.releases} ↗</a>
            <a class="btn btn-soft btn-sm" href={site.links.changelog} target="_blank" rel="noopener">{t.download.changelog} ↗</a>
          </div>
          <p class="faint fine" set:html={t.download.note} />
        </div>
        <div class="download-side">
          <dl class="download-meta">
            <dt>{t.download.meta.version}</dt><dd>{site.version}</dd>
            <dt>{t.download.meta.blender}</dt><dd>{site.blenderMin} – {site.blenderMax}</dd>
            <dt>{t.download.meta.platforms}</dt><dd>{t.download.meta.platformsValue}</dd>
            <dt>{t.download.meta.license}</dt><dd>{site.license}</dd>
            <dt>{t.download.meta.price}</dt><dd>{t.download.meta.priceValue}</dd>
          </dl>
          <p class="notice" set:html={t.status.note} />
        </div>
      </div>
    </div>
  </section>

  <!-- ============ FAQ ============ -->
  <Section id="faq" eyebrow={t.faq.eyebrow} title={t.faq.title}>
    <Faq items={t.faq.items} />
  </Section>

  <!-- ============ SUPPORT ============ -->
  <Section id="support" eyebrow={t.support.eyebrow} title={t.support.title}>
    <div class="grid grid-3">
      <div class="card">
        <h3>{t.support.cards.bug.title}</h3>
        <p class="muted">{t.support.cards.bug.body}</p>
        <a class="btn btn-soft btn-sm" href={site.links.newIssue}>{t.support.cards.bug.link}</a>
      </div>
      <div class="card">
        <h3>{t.support.cards.feature.title}</h3>
        <p class="muted">{t.support.cards.feature.body}</p>
        <a class="btn btn-soft btn-sm" href={site.links.newIssue}>{t.support.cards.feature.link}</a>
      </div>
      <div class="card">
        <h3>{t.support.cards.contribute.title}</h3>
        <p class="muted">{t.support.cards.contribute.body}</p>
        <a class="btn btn-soft btn-sm" href={site.links.contributing}>{t.support.cards.contribute.link}</a>
      </div>
    </div>
  </Section>
</Base>

<style>
  .hero {
    padding-block: clamp(3.5rem, 9vw, 7rem) 0;
  }
  .hero-copy {
    max-width: 880px;
    margin: 0 auto;
    text-align: center;
  }
  .pills {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
    margin-bottom: 1.75rem;
  }
  .soft-word {
    color: var(--text-faint);
  }
  .lead {
    font-size: clamp(1.1rem, 1.8vw, 1.25rem);
    font-weight: 300;
    color: var(--text-muted);
    max-width: 58ch;
    margin: 1.5rem auto 0;
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin: 2rem 0 1rem;
  }
  .hero .cta {
    justify-content: center;
  }
  .fine {
    font-size: 0.8125rem;
    margin: 0;
  }
  .hero-media {
    margin-top: clamp(2.5rem, 6vw, 4.5rem);
  }
  .hero-notice {
    max-width: 880px;
    margin: 1rem auto 0;
  }
  .stack {
    display: grid;
    gap: clamp(3.5rem, 7vw, 6rem);
  }
  .steps-grid {
    gap: 1.5rem;
  }
  .step h3 {
    margin-top: 1.25rem;
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .num {
    display: inline-grid;
    place-items: center;
    width: 1.8rem;
    height: 1.8rem;
    border-radius: 50%;
    background: var(--ink);
    color: var(--on-ink);
    font-size: 0.8rem;
  }
  .step p {
    font-size: 0.9375rem;
  }
  .split h3 {
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: var(--w-head);
    line-height: 1.13;
  }
  .shapes {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
  }
  ul.plain,
  ol.plain {
    padding-left: 1.2rem;
    margin: 0;
  }
  ul.plain li,
  ol.plain li {
    margin-bottom: 0.5rem;
  }
  .limits {
    grid-column: 1 / -1;
  }
  .quickstart h3 {
    margin-bottom: 1rem;
  }
  .download-box {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: clamp(2rem, 5vw, 3.5rem);
    align-items: start;
    padding: clamp(1.75rem, 5vw, 3.5rem);
    border-radius: var(--r-md);
    background: var(--canvas-soft);
  }
  .download-box .eyebrow {
    background: var(--canvas);
  }
  .download-box h2 {
    font-size: clamp(1.75rem, 3.5vw, 2.5rem);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
  }
  .ver {
    white-space: nowrap;
  }
  .download-box .cta {
    margin-bottom: 0.75rem;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.25rem;
  }
  .links .btn-soft {
    background: var(--canvas);
  }
  .download-side {
    display: grid;
    gap: 1rem;
  }
  .download-side .notice {
    background: var(--canvas);
  }
  .download-meta {
    display: grid;
    grid-template-columns: auto 1fr;
    margin: 0;
    padding: 0.5rem 1.5rem;
    border-radius: var(--r-md);
    background: var(--canvas);
    font-size: 0.9375rem;
  }
  .download-meta dt,
  .download-meta dd {
    padding: 0.8rem 0;
    border-bottom: 1px solid var(--hairline-soft);
  }
  .download-meta dt:last-of-type,
  .download-meta dd:last-of-type {
    border-bottom: 0;
  }
  .download-meta dt {
    color: var(--text-muted);
    padding-right: 1.5rem;
  }
  .download-meta dd {
    margin: 0;
    font-weight: var(--w-strong);
    text-align: right;
  }
  #support .card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  #support .card .btn {
    margin-top: auto;
  }
  @media (max-width: 860px) {
    .download-box {
      grid-template-columns: 1fr;
    }
  }
</style>
