---
import Base from "../layouts/Base.astro";
import Media from "../components/Media.astro";
import Section from "../components/Section.astro";
import Feature from "../components/Feature.astro";
import Faq from "../components/Faq.astro";
import { site } from "../data/site";
import { media } from "../data/media";

const faq = [
  {
    q: "Is it really free?",
    a: `Yes. ${site.name} is free software under the GNU GPL v3.0 or later: use it, study it, change it and share it, also commercially, as long as derivative works keep the same license.`,
  },
  {
    q: "Which Blender versions are supported?",
    a: `Blender ${site.blenderMin} through ${site.blenderMax}. The test-suite runs headless on both LTS ends on every commit. Windows, macOS and Linux.`,
  },
  {
    q: "Does it modify my original model?",
    a: "Not in Plan Mode. Cuts are stored as records and only run when you press <strong>Build</strong>; the source object is kept in a hidden <code>ESP_Backup</code> collection when <em>Keep Original</em> is on. <strong>Back to Plan</strong> restores the draft at any time.",
  },
  {
    q: "What clearance should I use for the connectors?",
    a: "It depends on your printer, material and slicer. 0.15–0.4 mm covers most FDM setups; resin printers can go tighter. Print a small test pair first — a tapered pin is the most forgiving shape.",
  },
  {
    q: "Can I use my own connector shapes?",
    a: "Yes. Open the connector library (icon next to <em>Shape</em>), drop any rigid mesh into the <code>ESP_Connectors</code> collection following the unit-box convention and it appears in the Shape menu.",
  },
  {
    q: "What about articulated joints or ball joints?",
    a: "Out of scope by design: connectors are rigid pins and sockets for gluing or press-fitting parts back together.",
  },
  {
    q: "My cut fails or gives a strange result.",
    a: "Boolean operations need a closed, manifold mesh with applied scale. Run <em>Check Mesh</em> first. Very dense meshes take longer; the <em>Manifold</em> solver (Blender 4.5+) is picked automatically when available. Enable <em>Skip Failed Cuts</em> to keep building the rest.",
  },
];
---

<Base>
  <!-- ============ HERO ============ -->
  <section class="hero">
    <div class="container">
      <div class="hero-grid">
        <div class="hero-copy">
          <div class="pills">
            <span class="pill teal">Free &amp; open source</span>
            <span class="pill">Blender {site.blenderMin} – {site.blenderMax}</span>
            <span class="pill">Windows · macOS · Linux</span>
          </div>
          <h1>Cut. Connect. <span class="grad">Print.</span></h1>
          <p class="lead">
            Split any model into printable parts with plane, curve or freehand cuts, add pin-and-socket
            connectors that actually fit, and export one file per part — without ever touching the original mesh.
          </p>
          <div class="cta">
            <a class="btn btn-primary" href="#download">
              Download v{site.version} <small>· free</small>
            </a>
            <a class="btn btn-ghost" href={site.repoUrl} target="_blank" rel="noopener">View on GitHub</a>
          </div>
          <p class="faint fine">
            GPL-3.0-or-later · Blender add-on · Exports STL / OBJ / FBX in millimetres
          </p>
        </div>
        <div class="hero-media">
          <Media slot={media.hero} large />
        </div>
      </div>
    </div>
  </section>

  <!-- ============ WORKFLOW ============ -->
  <Section
    id="workflow"
    eyebrow="Workflow"
    title="Three steps from a model to printable parts"
    intro="The whole tool lives in one sidebar tab. Draw where the cut should go, let the add-on place the connectors, export."
  >
    <div class="grid grid-3 steps-grid">
      <div class="step">
        <Media slot={media.stepCut} />
        <h3><span class="num">1</span> Draw the cut</h3>
        <p class="muted">
          Drag a line for a flat cut, sketch a curve, or draw a loop around a neck or wrist directly on the
          surface. Cuts follow the view, so what you draw is what you get.
        </p>
      </div>
      <div class="step">
        <Media slot={media.stepConnectors} />
        <h3><span class="num">2</span> Generate connectors</h3>
        <p class="muted">
          A pin on one side, a matching socket on the other. Pick the shape and size, set the clearance for
          your printer, swap sides or move the connector by hand.
        </p>
      </div>
      <div class="step">
        <Media slot={media.stepExport} />
        <h3><span class="num">3</span> Export printable parts</h3>
        <p class="muted">
          One click writes one STL, OBJ or FBX per part into a folder, already in millimetres. Check the fit in
          Exploded View before you print.
        </p>
      </div>
    </div>
  </Section>

  <!-- ============ PLAN MODE ============ -->
  <Section
    id="plan-mode"
    eyebrow="Plan Mode"
    title="Plan every cut. Build when you're ready."
    intro="Plan Mode is non-destructive: cuts are lightweight records with a live preview. Edit, move, disable or delete them, then Build all at once. Go back to the plan as many times as you need — the original model is never modified."
  >
    <div class="stack">
      <div class="split">
        <div>
          <h3>Plane Cut</h3>
          <p class="muted">
            Drag a line across the model and a flat cut is placed through it. Select the cut in the list and
            use <strong>Edit Cut Surface</strong> to move, rotate or scale the plane with <kbd>G</kbd>
            <kbd>R</kbd> <kbd>S</kbd> — the connector follows.
          </p>
          <ul class="checks">
            <li><strong>Two Contacts / Base Split</strong> — cut both feet off a base in one go, each with its own connector</li>
            <li><strong>Chain Cuts</strong> — start the next cut automatically</li>
            <li>Connector position, rotation and scale editable per cut</li>
          </ul>
        </div>
        <Media slot={media.planeCut} />
      </div>

      <div class="split reverse">
        <div>
          <h3>Curve Cut</h3>
          <p class="muted">
            Draw a curved line over the model and the cut follows it all the way through. Drag control points
            afterwards, add or remove them, or slide the whole curve; smoothing and point count are yours to set.
          </p>
          <ul class="checks">
            <li>Cut surface extruded along the view direction</li>
            <li>Point editor: drag, <kbd>Ctrl</kbd>+click to add, <kbd>X</kbd> to delete, <kbd>Ctrl</kbd>+<kbd>Z</kbd> undo</li>
          </ul>
        </div>
        <Media slot={media.curveCut} />
      </div>

      <div class="split">
        <div>
          <h3>Freehand Cut</h3>
          <p class="muted">
            For everything a plane can't reach: draw a closed loop <em>around</em> the surface — a neck, a
            wrist, a tail — orbiting between strokes. The loop is filled and used as the cut surface.
          </p>
          <ul class="checks">
            <li>Orbit with <kbd>MMB</kbd> while drawing, close the loop at the start point or with <kbd>Enter</kbd></li>
            <li>Smoothing and control-point count adjustable before and after</li>
          </ul>
        </div>
        <Media slot={media.freehandCut} />
      </div>

      <div class="split reverse">
        <div>
          <h3>Build, review, approve</h3>
          <p class="muted">
            <strong>Build</strong> runs the booleans and puts the parts in an <code>ESP_Built_&lt;name&gt;</code>
            collection. Not happy? <strong>Back to Plan</strong> restores the draft with every cut intact.
            <strong>Approve</strong> finishes and, with <em>Keep Original</em>, parks the source model in a hidden
            backup collection.
          </p>
          <ul class="checks">
            <li>Untick <em>Ready</em> to leave a cut out of the build, hide its preview or delete it</li>
            <li><strong>Skip Failed Cuts</strong> keeps building when one boolean fails</li>
            <li>Optional voxel <strong>Remesh</strong> of the built parts</li>
          </ul>
        </div>
        <Media slot={media.buildExport} />
      </div>
    </div>
  </Section>

  <!-- ============ QUICK CUT ============ -->
  <Section
    id="quick-cut"
    eyebrow="Quick Cut"
    title="Or just cut it now"
    intro="Quick Cut is the immediate mode: draw once and get the final parts with the connector already in place. No plan, no history — the same tools, the fastest path."
  >
    <div class="split">
      <Media slot={media.quickCut} />
      <div>
        <ul class="checks">
          <li><strong>Plane, Curve and Freehand</strong> all work in Quick Cut</li>
          <li>Automatic connector using the current shape, size and clearance</li>
          <li>Parts named by side: <code>_UPPER/_LOWER</code>, <code>_LEFT/_RIGHT</code>, <code>_FRONT/_BACK</code></li>
          <li>Switch to Plan Mode at any time with one toggle</li>
        </ul>
      </div>
    </div>
  </Section>

  <!-- ============ CONNECTORS ============ -->
  <Section
    id="connectors"
    eyebrow="Connectors"
    title="Pins and sockets that fit your printer"
    intro="Every cut gets a pin on one side and a matching socket on the other. Tune the fit once in the preferences and forget about it."
  >
    <div class="split">
      <div>
        <div class="shapes">
          <span class="pill accent">Cylinder</span>
          <span class="pill accent">Tapered</span>
          <span class="pill accent">Hexagon</span>
          <span class="pill accent">Box</span>
          <span class="pill">+ your own meshes</span>
        </div>
        <ul class="checks">
          <li><strong>Size presets</strong> or explicit width and height in millimetres</li>
          <li><strong>Clearance</strong> between pin and socket, printer specific</li>
          <li><strong>Asymmetric tip</strong> — deeper socket than pin, plus extra tip length</li>
          <li><strong>Pin side</strong> A or B, swap with one click</li>
          <li><strong>Manual adjust</strong> — select the connector and move, rotate or scale it freely, reset any time</li>
          <li><strong>Cut gap (kerf)</strong> — material removed along the cut so parts don't touch</li>
          <li><strong>Custom library</strong> — any rigid mesh in the <code>ESP_Connectors</code> collection shows up in the Shape menu</li>
        </ul>
      </div>
      <Media slot={media.connectors} />
    </div>
  </Section>

  <!-- ============ FEATURES ============ -->
  <Section id="features" eyebrow="Everything included" title="Feature list">
    <div class="grid grid-3">
      <Feature icon="📐" title="Plane Cut">Drag a line in the viewport → flat cut through the model.</Feature>
      <Feature icon="〰️" title="Curve Cut">Draw a curved line over the model → the cut follows it through.</Feature>
      <Feature icon="🔄" title="Freehand Cut">Closed loop around the surface, orbit while drawing → filled cut surface.</Feature>
      <Feature icon="🦶" title="Two Contacts / Base Split">Two contacts cut as one operation, each with its own connector.</Feature>
      <Feature icon="⚡" title="Quick Cut mode">Immediate final parts, no history.</Feature>
      <Feature icon="🗂️" title="Plan Mode">Non-destructive records, editable surfaces and connectors, Build / Back to Plan / Approve.</Feature>
      <Feature icon="🔩" title="Connectors">Cylinder, Tapered, Hexagon, Box or custom meshes; presets or explicit size; clearance; asymmetric tip; pin side; manual transform.</Feature>
      <Feature icon="📏" title="Cut Gap (kerf)">Material removed along the cut so parts don't touch.</Feature>
      <Feature icon="🧊" title="Remesh">Optional voxel remesh of the built parts.</Feature>
      <Feature icon="💥" title="Exploded View">Move the parts apart to inspect the connectors, collapse back.</Feature>
      <Feature icon="📦" title="Export">One file per part — STL, OBJ, FBX — to a folder, in millimetres.</Feature>
      <Feature icon="✅" title="Check Mesh">Manifold check with a warning before cutting.</Feature>
    </div>
  </Section>

  <!-- ============ WHO ============ -->
  <Section id="who" eyebrow="Made for" title="Who is it for?">
    <div class="grid grid-3">
      <div class="card">
        <h3>Miniature &amp; figure makers</h3>
        <p class="muted">Split busts and figurines at necks, wrists and bases so each part prints upright with minimal supports.</p>
      </div>
      <div class="card">
        <h3>Cosplay &amp; props</h3>
        <p class="muted">Helmets, armour and weapons bigger than the build plate — cut them into pieces that pin back together.</p>
      </div>
      <div class="card">
        <h3>Product &amp; mechanical prototyping</h3>
        <p class="muted">Explicit millimetre sizes, clearance and kerf: parts that fit the way the CAD says they should.</p>
      </div>
      <div class="card">
        <h3>Print farms &amp; hobbyists</h3>
        <p class="muted">Plan a whole model once, rebuild after tweaks, export every part with one click.</p>
      </div>
    </div>
  </Section>

  <!-- ============ COMPAT ============ -->
  <Section id="compat" eyebrow="Requirements" title="Compatibility, performance & limits">
    <div class="grid grid-2">
      <div class="card">
        <h3>Compatibility</h3>
        <ul class="checks">
          <li>Blender <strong>{site.blenderMin} – {site.blenderMax}</strong>, tested headless on both LTS ends in CI</li>
          <li>Windows, macOS and Linux</li>
          <li>Closed, <strong>manifold</strong> meshes with applied scale and rotation</li>
          <li>Millimetre scene (unit scale 0.001) or the <em>1 unit = 1 mm</em> preference</li>
        </ul>
      </div>
      <div class="card">
        <h3>Performance</h3>
        <ul class="checks">
          <li>Planning is instant: geometry only runs on <strong>Build</strong></li>
          <li>Build time depends on polygon count and the boolean solver</li>
          <li><em>Manifold</em> solver (Blender 4.5+) used automatically, <em>Exact</em> as fallback</li>
        </ul>
      </div>
      <div class="card limits">
        <h3>Known limitations</h3>
        <ul class="plain muted">
          <li>Open, self-intersecting or broken meshes give wrong booleans — run <em>Check Mesh</em> first.</li>
          <li>Not a printability analyser: wall thickness, orientation, supports and tolerances are up to you.</li>
          <li>Connectors are rigid by design; no articulated or movable joints.</li>
          <li>Automatic bed-size based cut suggestions are on the roadmap, not in yet.</li>
        </ul>
      </div>
    </div>
  </Section>

  <!-- ============ INSTALL ============ -->
  <Section id="install" eyebrow="Installation" title="Install in under a minute">
    <div class="split">
      <ol class="steps">
        <li><strong>Download</strong> <code>easy_slice_print-{site.version}.zip</code> below.</li>
        <li>
          In Blender open <strong>Edit → Preferences → Add-ons</strong>, click the <strong>⌄</strong> menu in the top
          right and choose <strong>Install from Disk…</strong>, then pick the zip.
        </li>
        <li>Enable <strong>{site.name}</strong>.</li>
        <li>
          Press <kbd>N</kbd> in the 3D Viewport: the panel is in the <strong>EasySlice</strong> tab of the sidebar.
        </li>
      </ol>
      <div class="card quickstart">
        <h3>Quick start</h3>
        <ol class="plain muted">
          <li>Use a millimetre scene, or set <em>Preferences → EasySlice → Units → 1 unit = 1 mm</em>.</li>
          <li>Select a closed mesh, apply scale &amp; rotation (<kbd>Ctrl</kbd>+<kbd>A</kbd>). Run <em>Check Mesh</em> if unsure.</li>
          <li>Pick <strong>Quick Cut</strong> or <strong>Plan Mode</strong>, click <strong>Plane</strong>, <strong>Curve</strong> or <strong>Freehand</strong> and draw.</li>
          <li>Set the connector shape, size, pin side, cut gap and clearance.</li>
          <li><strong>Build</strong>, check the fit in <strong>Exploded View</strong>, <strong>Export</strong>.</li>
        </ol>
        <p class="faint fine">Clearance is printer specific (0.15–0.4 mm typical). Test print a small piece first.</p>
      </div>
    </div>
  </Section>

  <!-- ============ DOWNLOAD ============ -->
  <section id="download" class="section download">
    <div class="container">
      <div class="download-box">
        <div>
          <span class="eyebrow">Download</span>
          <h2>{site.name} v{site.version}</h2>
          <p class="muted">
            Free, no account, no license key. The zip installs straight into Blender. Source code, issues and
            older versions are on GitHub.
          </p>
          <div class="cta">
            <a class="btn btn-primary" href={site.links.downloadZip}>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 3v12m0 0 4-4m-4 4-4-4M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2" />
              </svg>
              easy_slice_print-{site.version}.zip
            </a>
            <a class="btn btn-ghost" href={site.links.releases} target="_blank" rel="noopener">All releases</a>
            <a class="btn btn-ghost" href={site.links.changelog} target="_blank" rel="noopener">Changelog</a>
          </div>
          <p class="faint fine">
            Also coming to the Blender Extensions platform, so you can install it from <em>Preferences → Get Extensions</em>.
          </p>
        </div>
        <div class="download-meta">
          <dl>
            <dt>Version</dt><dd>{site.version}</dd>
            <dt>Blender</dt><dd>{site.blenderMin} – {site.blenderMax}</dd>
            <dt>Platforms</dt><dd>Windows · macOS · Linux</dd>
            <dt>License</dt><dd>{site.license}</dd>
            <dt>Price</dt><dd>Free</dd>
          </dl>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ FAQ ============ -->
  <Section id="faq" eyebrow="FAQ" title="Questions & answers">
    <Faq items={faq} />
  </Section>

  <!-- ============ SUPPORT ============ -->
  <Section id="support" eyebrow="Support & roadmap" title="Actively developed, in the open">
    <div class="grid grid-3">
      <div class="card">
        <h3>Found a bug?</h3>
        <p class="muted">Open an issue with your Blender version and, if you can, the .blend file. Crashes and wrong cuts get priority.</p>
        <a href={site.links.newIssue}>Report on GitHub →</a>
      </div>
      <div class="card">
        <h3>Want a feature?</h3>
        <p class="muted">Bed-size based cut suggestions are next on the list. Vote, discuss or propose your own in the tracker.</p>
        <a href={site.links.newIssue}>Request a feature →</a>
      </div>
      <div class="card">
        <h3>Want to contribute?</h3>
        <p class="muted">Pure-geometry core, headless tests on two Blender versions, ruff-formatted Python. Pull requests welcome.</p>
        <a href={site.links.contributing}>Read the guide →</a>
      </div>
    </div>
  </Section>
</Base>

<style>
  .hero {
    padding-block: clamp(3rem, 8vw, 6rem) clamp(3rem, 6vw, 5rem);
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }
  @media (max-width: 960px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }
  }
  .pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.4rem;
  }
  .grad {
    background: linear-gradient(90deg, var(--accent), #ffb37a);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .lead {
    font-size: clamp(1.05rem, 1.6vw, 1.25rem);
    color: var(--text-muted);
    max-width: 56ch;
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin: 1.75rem 0 1rem;
  }
  .fine {
    font-size: 0.85rem;
    margin: 0;
  }
  .stack {
    display: grid;
    gap: clamp(3rem, 6vw, 5rem);
  }
  .steps-grid {
    gap: 2rem;
  }
  .step h3 {
    margin-top: 1.2rem;
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .num {
    display: inline-grid;
    place-items: center;
    width: 1.8rem;
    height: 1.8rem;
    border-radius: 50%;
    background: var(--accent-soft);
    color: var(--accent);
    font-family: var(--mono);
    font-size: 0.85rem;
  }
  .step p {
    font-size: 0.95rem;
  }
  .shapes {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.4rem;
  }
  ul.plain,
  ol.plain {
    padding-left: 1.2rem;
    margin: 0;
  }
  ul.plain li,
  ol.plain li {
    margin-bottom: 0.5rem;
  }
  .limits {
    grid-column: 1 / -1;
  }
  .quickstart h3 {
    margin-bottom: 0.9rem;
  }
  .download {
    background: linear-gradient(180deg, var(--bg-elev), transparent);
  }
  .download-box {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 2.5rem;
    align-items: center;
    padding: clamp(1.5rem, 4vw, 3rem);
    border-radius: 20px;
    border: 1px solid var(--border);
    background:
      radial-gradient(600px 300px at 0% 0%, rgba(255, 138, 61, 0.16), transparent 60%),
      var(--surface);
  }
  .download .eyebrow {
    display: inline-block;
    font-family: var(--mono);
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--accent);
    margin-bottom: 0.75rem;
  }
  .download-meta dl {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.5rem 1.25rem;
    margin: 0;
    padding: 1.25rem 1.5rem;
    border-radius: var(--radius);
    background: var(--bg);
    border: 1px solid var(--border);
    font-size: 0.95rem;
  }
  .download-meta dt {
    color: var(--text-faint);
  }
  .download-meta dd {
    margin: 0;
    font-family: var(--mono);
  }
  @media (max-width: 860px) {
    .download-box {
      grid-template-columns: 1fr;
    }
  }
</style>
